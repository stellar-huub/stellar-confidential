# Copy to .env and adjust. Every variable the services read is listed here.

# ---------------------------------------------------------------- Stellar RPC
# Local quickstart network started by docker-compose.
STELLAR_RPC_URL=http://localhost:8000/rpc
STELLAR_NETWORK_PASSPHRASE=Standalone Network ; February 2017

# Confidential Token contract ids to index, comma separated.
# Leave empty to index every contract event the adapter recognises.
CONFIDENTIAL_CONTRACT_IDS=

# ------------------------------------------------------------------- Storage
# Points at the docker-compose PostgreSQL by default.
DATABASE_URL=postgres://confidential:confidential@localhost:55432/confidential_indexer
DATABASE_POOL_MAX=10

# Redis is optional. Unset it to fall back to an in-process cache.
REDIS_URL=redis://localhost:56379

# ------------------------------------------------------------------ Ingestion
# Ledger to begin backfilling from. 0 means "oldest ledger the RPC retains".
INGEST_START_LEDGER=0
# Ledgers requested per getEvents page.
INGEST_PAGE_SIZE=200
# Poll interval while following the network tip, milliseconds.
INGEST_POLL_INTERVAL_MS=2000
# How many ledgers of history to keep. 0 disables pruning.
RETENTION_LEDGERS=0

# ------------------------------------------------------------------- Services
INDEXER_HTTP_PORT=4000
RECOVERY_HTTP_PORT=4010
LOG_LEVEL=info

# Requests per minute per client, per service. 0 disables rate limiting.
RATE_LIMIT_PER_MINUTE=600
